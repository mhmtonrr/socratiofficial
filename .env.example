# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# =============================================================================
# DATABASE (PostgreSQL via Docker)
# docker run --name socratiofficial-postgres \
#   -e POSTGRES_USER=socrati \
#   -e POSTGRES_PASSWORD=socrati_dev_password \
#   -e POSTGRES_DB=socratiofficial \
#   -p 5432:5432 -d postgres:16
# =============================================================================
DATABASE_URL="postgresql://socrati:socrati_dev_password@localhost:5432/socratiofficial"

# =============================================================================
# NEXTAUTH
# Generate secret: openssl rand -base64 32
# =============================================================================
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# CLOUDINARY (image uploads)
# https://cloudinary.com/console
# =============================================================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# =============================================================================
# PAYFAST (redirect-based payment gateway)
# Sandbox: https://sandbox.payfast.co.za
# Docs: https://developers.payfast.co.za/api
# =============================================================================
PAYFAST_MERCHANT_ID="your-merchant-id"
PAYFAST_MERCHANT_KEY="your-merchant-key"
PAYFAST_PASSPHRASE="your-passphrase"
PAYFAST_SANDBOX="true"

# =============================================================================
# PEACH PAYMENTS (embedded checkout)
# Sandbox dashboard: https://sandbox-dashboard.peachpayments.com
# Set PEACH_SANDBOX="false" for production
# =============================================================================
PEACH_SANDBOX="true"
PEACH_CLIENT_ID="your-peach-client-id"
PEACH_CLIENT_SECRET="your-peach-client-secret"
PEACH_MERCHANT_ID="your-peach-merchant-id"
NEXT_PUBLIC_PEACH_ENTITY_ID="your-peach-entity-id"

# =============================================================================
# APP URL
# For local webhook testing, run: ngrok http 3000
# Then replace with your ngrok https URL
# Webhook endpoints:
#   PayFast ITN  → POST {APP_URL}/api/payfast/notify
#   Peach notify → POST {APP_URL}/api/peach/notify
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# GOOGLE MAPS (address autocomplete on checkout)
# https://console.cloud.google.com
# Enable: Maps JavaScript API + Places API
# =============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
